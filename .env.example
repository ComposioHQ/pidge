# Pidge runtime configuration (validated by shared/environment/env.ts). Copy to .env.local; never commit real values.

# Canonical public origin (no trailing slash). Better Auth uses it unless BETTER_AUTH_URL is set.
APP_URL=https://pidge.example.com
# BETTER_AUTH_URL=
# 32+ random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=

# PostgreSQL (pooled runtime URL, and a direct URL for migrations)
DATABASE_URL=postgres://pidge:pidge@127.0.0.1:5432/pidge
DATABASE_URL_UNPOOLED=postgres://pidge:pidge@127.0.0.1:5432/pidge

# Composio scoped project key: Session management (read/write), Session tool execution (write),
# Connected accounts (read/write).
COMPOSIO_API_KEY=
# Optional deployment toolkit policy (comma-separated slugs). An explicitly empty allowlist disables all toolkits.
# COMPOSIO_TOOLKIT_ALLOWLIST=
# COMPOSIO_TOOLKIT_DENYLIST=

# Photon Stable project (portable credentials) and the signing secret of the webhook pointing at /eve/v1/photon
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=

# Vercel AI Gateway (models and Exa web search)
AI_GATEWAY_API_KEY=
PIDGE_DEFAULT_MODEL=anthropic/claude-sonnet-5

# Absolute directory for private artifacts (owner-only permissions)
ARTIFACT_STORAGE_DIR=/absolute/path/owned/by/your-runtime-user/artifacts

# Port Next.js listens on; the server reaches its own /eve/v1 routes through it.
PORT=8000
# EVE_INTERNAL_ORIGIN=http://127.0.0.1:8000

# Optional bearer token for POST /api/notify (one trusted caller texts the owner; docs/decisions.md D14).
# Unset or empty disables the endpoint. e.g. `openssl rand -hex 32`
# PIDGE_NOTIFY_TOKEN=


# Test-only database, dropped and recreated by pnpm test. Never point at wanted data.
# TEST_DATABASE_URL=postgres://pidge:pidge@127.0.0.1:5432/pidge_test

# Optional noninteractive input to setup:owner. Otherwise it prompts on the console.
# OWNER_PASSWORD=

# Optional Composio V3 project webhook secret for POST /api/triggers/composio.
# Unset disables event setup/intake. See docs/app-events-setup.md before registering the project webhook.
# COMPOSIO_WEBHOOK_SECRET=

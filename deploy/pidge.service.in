[Unit]
Description=Pidge experimental assistant (Next.js + Eve)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=@PIDGE_RUNTIME_USER@
Group=@PIDGE_RUNTIME_USER@
WorkingDirectory=@PIDGE_REMOTE_DIR@
EnvironmentFile=@PIDGE_REMOTE_DIR@/.env.local
Environment=NODE_ENV=production
ExecStart=/usr/bin/env pnpm exec next start --hostname 127.0.0.1 --port ${PORT}
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
